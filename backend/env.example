# Variables de entorno para Coofisam360 Backend
# Copia este archivo a .env y configura los valores

# Configuración de Django
DEBUG=True
SECRET_KEY=tu-clave-secreta-aqui
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/coofisam360

# Configuración de archivos
MEDIA_ROOT=/home/desarrollo/coofisam360/backend/django/media
STATIC_ROOT=/home/desarrollo/coofisam360/backend/django/staticfiles

# Configuración de archivos Excel
LIBRO_BALANCE_ROOT=/home/desarrollo/Coofisam/data/Libro_de_Balance_x_Aanoo

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

